# ============================================================
# Esperanza — Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env or .env.production — they contain secrets.
# Both Prisma and Next.js read from .env automatically.
# ============================================================

# --- PostgreSQL (used by docker-compose and Prisma) ---
POSTGRES_USER=esperanza
POSTGRES_PASSWORD=esperanza_dev_password
POSTGRES_DB=esperanza

# --- Database connection (used by Prisma ORM) ---
# For local dev (Postgres running in Docker on localhost):
DATABASE_URL=postgresql://esperanza:esperanza_dev_password@localhost:5432/esperanza
# For production (docker-compose.prod.yml on the VM):
# DATABASE_URL=postgresql://esperanza:change_me_to_a_strong_password@postgres:5432/esperanza

# --- Auth.js v5 ---
# Generate a secret: openssl rand -base64 32
# WARNING: paste ONLY the secret value, do NOT include the key name in the value
AUTH_SECRET=generate_a_secret_with_openssl_rand_base64_32
# NEXTAUTH_URL is intentionally unset so Auth.js uses the request Host header
# (works for both localhost and network IP access via trustHost: true in auth.ts)
# NEXTAUTH_URL=http://localhost:3000

# --- Mapbox (used for address autocomplete + location picker in event forms) ---
# Create a token at https://account.mapbox.com/access-tokens/
# Recommended scopes: styles:read, geocoding:read
# Add URL restrictions in the Mapbox dashboard to prevent key abuse.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# --- Supabase Storage (used for event image uploads) ---
# Create a project at https://supabase.com/ and set up a public storage bucket
# (default bucket name below is "event-images").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co/
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=event-image

# --- Translation (LibreTranslate) ---
# Base URL for the translation service. In docker-compose, you might use:
#   TRANSLATION_BASE_URL=http://libretranslate:5001
# For local dev without Docker, you can point to a local instance:
#   TRANSLATION_BASE_URL=http://localhost:5001
TRANSLATION_BASE_URL=http://localhost:5001

# Timeout (in milliseconds) for translation HTTP requests.
TRANSLATION_TIMEOUT_MS=3000

# --- App ---
NODE_ENV=development
# Public site URL (required for docker-compose.prod.yml build args and ICS links).
# Example: https://your-subdomain.duckdns.org
NEXT_PUBLIC_APP_URL=http://localhost:3000