# ============================================================
# Esperanza — Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env or .env.production — they contain secrets.
# Next.js reads .env automatically; the Prisma CLI falls back to a local
# SQLite file (see prisma.config.ts) when DATABASE_URL is unset.
# ============================================================

# --- Database (SQLite via Prisma driver adapter) ---
# Local dev: a file in the repo. On NPTS infra set this to the EFS path so the
# DB persists across container restarts:  DATABASE_URL=file:/efs/prod.db
DATABASE_URL=file:./prisma/dev.db

# --- Better Auth ---
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: paste ONLY the secret value, do NOT include the key name in the value
BETTER_AUTH_SECRET=generate_a_secret_32_bytes_base64
# Public base URL of the app. Local dev can leave this unset (origin is derived
# from the request). In prod set it so auth callbacks/redirects are correct:
#   BETTER_AUTH_URL=https://esperanza.npts.tech

# --- Image uploads (stored on the local filesystem / EFS) ---
# Local dev defaults to ./uploads (gitignored). On NPTS infra point this at EFS:
#   UPLOAD_STORAGE_PATH=/efs/uploads
UPLOAD_STORAGE_PATH=./uploads

# --- Maps & geocoding ---
# Maps use MapLibre GL + OpenFreeMap tiles (free, keyless — nothing to set).
#
# Address autocomplete uses Geoapify (fast; free tier ~3k req/day). Create a key at
# https://myprojects.geoapify.com and restrict it to your origins (localhost + prod).
# If this is unset, it falls back to the free keyless Photon public instance (slow).
NEXT_PUBLIC_GEOAPIFY_KEY=your_geoapify_api_key_here
# Optional self-hosted Photon fallback target (only used when no Geoapify key):
# NEXT_PUBLIC_PHOTON_URL=https://photon.yourdomain.com
# Address search is hard-scoped to the DFW metroplex by default. Widen the box as
# "minLon,minLat,maxLon,maxLat" (e.g. all of Texas) if events range further:
# NEXT_PUBLIC_GEOCODE_BBOX=-106.7,25.8,-93.5,36.6

# --- Translation (LibreTranslate) ---
# Base URL for the translation service. docker-compose runs one on :5001.
# Leave unset to disable translation (bilingual fields fall back to the source text).
TRANSLATION_BASE_URL=http://localhost:5001
TRANSLATION_TIMEOUT_MS=3000

# --- App ---
NODE_ENV=development
# Public site URL (used for ICS calendar links). On NPTS infra: https://esperanza.npts.tech
NEXT_PUBLIC_APP_URL=http://localhost:3000
