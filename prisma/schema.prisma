generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "sqlite"
}

// NOTE: SQLite has no native enum type. The former Postgres enums (Role,
// EventStatus, TargetRole, AnalyticsEventType) are stored as String; allowed
// values are enforced in the zod validators (src/lib/validators).

// Better Auth owns this table (email/password). Core fields use Better Auth's
// camelCase names; `created_at` is mapped back to createdAt in src/lib/auth.ts so
// the app's existing queries keep working. Passwords live in the Account table.
model User {
  id                   String             @id @default(uuid())
  name                 String
  email                String             @unique
  emailVerified        Boolean            @default(false)
  image                String?
  username             String?            @unique
  role                 String             @default("USER")
  language_pref        String             @default("en")
  share_with_providers Boolean            @default(true)
  consented_at         DateTime?
  created_at           DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  // Event reminder preferences (see src/lib/reminders.ts).
  reminder_push        Boolean            @default(true)
  reminder_email       Boolean            @default(true)
  reminder_lead_min    Int                @default(60)
  sessions             Session[]
  accounts             Account[]
  analytics            AnalyticsEvent[]
  announcements        Announcement[]     @relation("AuthorAnnouncements")
  demographics         Demographics?
  events               Event[]            @relation("ProviderEvents")
  rsvps                Rsvp[]
  provider_profile     ProviderProfile?
  provider_programs    ProviderProgramCategory[]
  interests            UserInterestEventCategory[]
  push_subscriptions   PushSubscription[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// TODO: Currently, Demographics is required for all users that sign up. 
// The UI hides that providers don't need to
// Need to fix how providers are created to begin with. 
model Demographics {
  id                      String  @id @default(uuid())
  user_id                 String  @unique
  ethnicity               String?
  age_band                String
  marital_status          String?
  children_under_5_count  Int     @default(0)
  children_5_to_18_count  Int     @default(0)
  children_over_18_count  Int     @default(0)
  county_of_residence     String
  employment_status       String?
  annual_income_bracket   String?
  education_level         String?
  primary_language        String
  race                    String
  gender                  String
  // TODO: delete age field, it's unused
  age                     Int?
  annual_personal_income  String?
  annual_household_income String?
  county                  String
  has_children_under_18   Boolean @default(false)
  has_children_under_5    Boolean @default(false)
  educational_attainment  String?
  has_personal_vehicle    Boolean @default(false)
  is_employed             Boolean @default(false)
  industry_area           String?
  user                    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("demographics")
}

model ProviderProfile {
  id            String  @id @default(uuid())
  user_id       String  @unique
  org_name      String?
  bio           String?
  logo_url      String?
  website_url   String?
  contact_email String?
  contact_phone String?
  beneficiaries String?
  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
}

model ProviderProgramCategory {
  user_id     String
  category_id String
  created_at  DateTime @default(now())
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    EventCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([user_id, category_id])
  @@map("provider_program_categories")
}

model EventCategory {
  id        String                     @id @default(uuid())
  slug      String                     @unique
  name_en   String
  name_es   String
  color     String
  emoji     String
  events    Event[]
  interests UserInterestEventCategory[]
  provider_programs ProviderProgramCategory[]

  @@map("event_categories")
}

// Which categories a user is interested in. Seeded (not admin-managed) for now;
// powers the "Interests" filter on the events page and profile preferences.
model UserInterestEventCategory {
  user_id     String
  category_id String
  created_at  DateTime @default(now())
  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    EventCategory    @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([user_id, category_id])
  @@map("user_interest_event_categories")
}

model Event {
  id               String   @id @default(uuid())
  title_en         String
  title_es         String
  description_en   String
  description_es   String
  location_name    String
  location_address String?
  latitude         Float
  longitude        Float
  start_time       DateTime
  end_time         DateTime
  provider_id      String
  status           String   @default("PENDING")
  category_id      String
  image_url        String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  provider         User           @relation("ProviderEvents", fields: [provider_id], references: [id])
  category         EventCategory  @relation(fields: [category_id], references: [id])
  rsvps            Rsvp[]

  @@index([category_id])
  @@map("events")
}

model Rsvp {
  id               String    @id @default(uuid())
  user_id          String
  event_id         String
  created_at       DateTime  @default(now())
  // Set when the reminder goes out; cleared when the event's start_time changes.
  reminder_sent_at DateTime?
  event            Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id])
  @@map("rsvps")
}

model PushSubscription {
  id         String   @id @default(uuid())
  user_id    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}

model Announcement {
  id          String   @id @default(uuid())
  title_en    String
  title_es    String
  body_en     String
  body_es     String
  author_id   String
  target_role String   @default("ALL")
  created_at  DateTime @default(now())
  author      User     @relation("AuthorAnnouncements", fields: [author_id], references: [id])

  @@map("announcements")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  user_id    String?
  event_type String
  metadata   Json?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])

  @@index([event_type, created_at])
  @@map("analytics_events")
}
